# Database
POSTGRES_USER=ecosystem
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=ecosystem_db
DATABASE_URL=postgresql+psycopg://ecosystem:change_me_in_production@localhost:5432/ecosystem_db

# Security & Sessions
SESSION_SECRET=generate-a-64-char-random-hex-string-here
FRONTEND_ORIGIN=http://localhost:5173

# S3-Compatible Object Storage (Cloudflare R2 / AWS S3 / MinIO)
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET_NAME=ecosystem-uploads-dev
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_REGION=auto

# LLM API for Grounded Opportunity Briefs
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_api_key
LLM_MODEL=gemini-2.5-flash

# Frontend Build Variables (Never put secrets here!)
VITE_API_BASE_URL=http://localhost:8000/api/v1
